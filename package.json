{
  "name": "sereno-ds",
  "version": "0.23.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=\"./packages/*\" && changeset publish",
    "gen:brand-images": "node scripts/generate-brand-images.mjs",
    "build:docs": "turbo run build --filter=docs",
    "build:demo": "turbo run build --filter=demo",
    "serve:docs": "serve apps/docs/out -l ${PORT:-3000} --no-clipboard --no-port-switching",
    "serve:demo": "serve apps/demo/out -l ${PORT:-3000} --no-clipboard --no-port-switching"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "turbo": "^2.5.8",
    "typescript": "^5"
  },
  "dependencies": {
    "serve": "^14.2.6"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "16.3.3",
    "@next/swc-linux-x64-musl": "16.3.3"
  }
}

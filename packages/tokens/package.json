{
  "name": "@sereno-ds/tokens",
  "version": "0.33.1",
  "description": "Sereno Design System — the token layer (CSS custom properties, light × dark).",
  "license": "MIT",
  "author": "Sereno",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielGomesBarbosa/sereno-ds.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/GabrielGomesBarbosa/sereno-ds/tree/main/packages/tokens#readme",
  "bugs": "https://github.com/GabrielGomesBarbosa/sereno-ds/issues",
  "type": "module",
  "keywords": [
    "design-tokens",
    "css-variables",
    "design-system",
    "sereno"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./tokens.css",
    "./tokens.css": "./tokens.css",
    "./colors.css": "./colors.css",
    "./typography.css": "./typography.css",
    "./spacing.css": "./spacing.css",
    "./radii.css": "./radii.css",
    "./elevation.css": "./elevation.css",
    "./motion.css": "./motion.css",
    "./base.css": "./base.css",
    "./breakpoints": {
      "types": "./dist/breakpoints.d.ts",
      "import": "./dist/breakpoints.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.css",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/check-breakpoints.mjs && tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

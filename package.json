{
  "name": "sereno-ds",
  "version": "0.23.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:visual": "npm run build:docs && bash scripts/visual.sh",
    "test:visual:update": "npm run build:docs && bash scripts/visual.sh --update-snapshots",
    "dev": "turbo run dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=\"./packages/*\" && changeset publish",
    "check:dashes": "node scripts/check-no-em-dash.mjs",
    "check:banner": "node scripts/check-banner.mjs",
    "api:update": "turbo run build --filter=@sereno-ds/ui --filter=@sereno-ds/tokens && node scripts/api-surface.mjs update",
    "api:check": "turbo run build --filter=@sereno-ds/ui --filter=@sereno-ds/tokens && node scripts/api-surface.mjs check",
    "check:packages": "publint packages/ui --strict && publint packages/tokens --strict && attw --pack packages/ui --profile esm-only --exclude-entrypoints ./styles.css && attw --pack packages/tokens --profile esm-only --entrypoints ./breakpoints",
    "gen:brand-images": "node scripts/generate-brand-images.mjs",
    "gen:component-docs": "tsx scripts/generate-design-system-docs.ts",
    "gen:banner": "bash scripts/banner.sh",
    "build:docs": "turbo run build --filter=docs",
    "build:demo": "turbo run build --filter=demo",
    "serve:docs": "serve apps/docs/out -l ${PORT:-3000} --no-clipboard --no-port-switching",
    "serve:demo": "serve apps/demo/out -l ${PORT:-3000} --no-clipboard --no-port-switching",
    "board": "node scripts/board.mjs",
    "test:scripts": "node --test scripts/"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "^2.31.1",
    "@microsoft/api-extractor": "7.60.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "publint": "0.3.25",
    "tsx": "4.23.13",
    "turbo": "^2.5.8",
    "typescript": "^5"
  },
  "dependencies": {
    "serve": "^14.2.6"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "16.3.3",
    "@next/swc-linux-x64-musl": "16.3.3"
  }
}

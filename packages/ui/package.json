{
  "name": "@sereno/ui",
  "version": "0.0.0",
  "description": "Sereno Design System — React primitives (token-driven, inline styles, no UI base lib).",
  "license": "MIT",
  "author": "Sereno",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielGomesBarbosa/sereno-ds.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/GabrielGomesBarbosa/sereno-ds/tree/main/packages/ui#readme",
  "bugs": "https://github.com/GabrielGomesBarbosa/sereno-ds/issues",
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "tokens",
    "sereno"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "next-themes": "^0.4.6"
  },
  "peerDependencies": {
    "lucide-react": ">=1",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lucide-react": "^1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
